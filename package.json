{
  "author": "Yevgenii Mikhnytskyi",
  "type": "module",
  "sideEffects": false,
  "description": "Type-safe useContext wrapper: sentinel default outside Provider, hook return type uses Exclude to drop the empty marker",
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.0.33",
    "@types/react-dom": "^18.0.0",
    "eslint": "^9.19.0",
    "@vitest/eslint-plugin": "^1.6.15",
    "husky": "^9.1.7",
    "jsdom": "^25.0.0",
    "lint-staged": "^15.4.3",
    "prettier": "^3.4.2",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tsdown": "^0.21.7",
    "typescript": "6.0.2",
    "typescript-eslint": "^8.22.0",
    "vitest": "^4.1.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "React",
    "Context",
    "Hooks",
    "createContext"
  ],
  "license": "MIT",
  "lint-staged": {
    "*.{ts,tsx,mjs,cjs,json,md,yml,yaml}": "prettier --write"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "name": "create-use-context",
  "packageManager": "pnpm@10.33.0",
  "peerDependencies": {
    "react": "^16.8.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/todesstoss/create-use-context.git"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepare": "husky",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "version": "3.0.0"
}
